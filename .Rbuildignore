^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.git$
^\.gitignore$
^\.DS_Store$
^README\.md$
^\.Rprofile$
^easybreedeR\.Rproj$
^suite_diagnostics\.log$
^pedigree_cache/
^root/
^.*_cache/
^\.svn$
^\.github/
^example_data/
^\.cursor$
^\.vscode$
^scripts$
^scripts/.*$
^src/.*\.tmp$

# Non-standard top-level files (documentation files)
^BUILD\.md$
^INSTALL\.md$
^PUBLISH\.md$
^OPTIMIZATION_PLAN\.md$
^P0_P1_IMPLEMENTATION\.md$
^HOSTING\.md$
^validation$
^\.claude$
^inst/.*/.*\.log$
^paper/

# Note: Development files are now only in inst/


# Exclude deployment metadata from package tarball
^inst/.*/rsconnect$
^inst/.*/rsconnect/.*$

# Local author AI secrets must never reach a tarball or installed library
^inst/.*/ai_author_env\.local\.R$
# Full GPL text is referenced by "License: GPL-3"; not shipped in the tarball
^LICENSE$
^src/.*\.(o|so|dll)$
